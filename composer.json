
{
    "name": "gatovel/cache",
    "description": "Sistema de cache modular e independente para aplicações PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cache",
        "redis",
        "php",
        "gatovel",
        "framework"
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "predis/predis": "^3.0"
    },
    "suggest": {
        "predis/predis": "Necessário para utilizar o RedisDriver."
    },
    "autoload": {
        "psr-4": {
            "Gatovel\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gatovel\\Cache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
